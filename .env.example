# Base de données (SQLite en dev). En production, passer en PostgreSQL :
# DATABASE_URL="postgresql://user:password@host:5432/vitrine"
DATABASE_URL="file:./dev.db"

# Clé de signature des sessions (obligatoire en production)
AUTH_SECRET="remplace-moi-par-une-chaine-aleatoire-de-32-caracteres"

# URL publique de l'application (utilisée pour afficher les liens de boutique)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Envoi de SMS pour les codes de vérification.
# Sans SMS_WEBHOOK_URL, les codes sont écrits dans les logs (mode démonstration)
# et affichés à l'écran hors production.
# SMS_WEBHOOK_URL="https://api.votre-fournisseur-sms.ci/send"
# SMS_API_KEY=""
